# DispatchPulse Environment Configuration Template

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=dispatchpulse_db

# In-Memory Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication (OAuth2 / JWT)
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# SMTP Transactional Email Notifications
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=notifications@dispatchpulse.io
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Twilio SMS Gateway
TWILIO_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1234567890
